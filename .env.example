# Copy this file to .env and fill in your values.
# .env is gitignored, so your keys stay private.

# OMDb API key (get one free at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Ruta al disco/carpeta con los vídeos
VIDEOS_ROOT=/Volumes/INES_6TB/VIDEOS

# Ruta a los reportes generados (por defecto: ~/reporte_videos)
REPORTES_DIR=/Users/inesg.calvo/reporte_videos
